cabal-version: 3.0
name:          liquid-order
version:       0.2.0
synopsis:      LCF-style higher-order refinement engine — Sovereign-Covenant verification
description:
  LiquidOrder is a higher-order refinement calculus integrated with the Sovereign-Covenant
  preregistered research protocol. Subtyping is predicate ordering. Recursion is fixed-point
  reasoning. Automation is proof-producing through an untrusted solver. A proposition is
  VERIFIED only when the trusted LCF kernel successfully reconstructs its derivation from
  a ProofCertificate. HOL is a logical expressivity framework — it is NOT a complexity class.
category:      Formal Methods
license:       MIT
author:        Jessica
maintainer:    jessicalw34@gmail.com

common defaults
  ghc-options:        -Wall -Wcompat
  default-language:   Haskell2010

library
  import:             defaults
  hs-source-dirs:     src
  exposed-modules:
    -- Trusted kernel (Thm constructor unexported)
    LiquidOrder.Kernel.Kernel
    LiquidOrder.Kernel.Certificate

    -- IR and type system
    LiquidOrder.IR.Types

    -- Epistemic type system
    LiquidOrder.Epistemic.Types

    -- Order theory and refinement
    LiquidOrder.Order.OrderTheory
    LiquidOrder.Refinement.Subtyping
    LiquidOrder.Refinement.FactorsThrough

    -- Automation (untrusted; produces certificates for kernel)
    LiquidOrder.Automation.Dispatch

    -- Sovereign-Covenant HOL formalization
    LiquidOrder.SovereignCovenant.HOLFormalization
    LiquidOrder.SovereignCovenant.Obligations

    -- Manifest
    LiquidOrder.Manifest.Manifest

    -- Pipeline
    LiquidOrder.Pipeline.Pipeline

    -- Track 3 isolation
    LiquidOrder.Track3.Omega

    -- Quantum / invariant layer (Ahmad's Dreamcycles runtime checks)
    LiquidOrder.Quantum.VerificationBridge

    -- Quantum Language B (Macrobit-Shard Hypothesis formalization)
    LiquidOrder.QuantumLangB.Types
    LiquidOrder.QuantumLangB.HOLFormalization
    LiquidOrder.QuantumLangB.Obligations
    LiquidOrder.QuantumLangB.Pipeline

    -- BlackHoleASM IR and opcode set
    LiquidOrder.QuantumLangB.BlackHoleASM.IR
    LiquidOrder.QuantumLangB.BlackHoleASM.Opcodes

    -- Haiku Learning Kernel (Curry/Haskell spec)
    LiquidOrder.HaikuKernel.WorldState
    LiquidOrder.HaikuKernel.Pipeline
    LiquidOrder.HaikuKernel.KillSwitch

  -- DreamcyclesInvariant.hs is a standalone Main executable, not a library module.
  -- Build it separately: ghc -O2 src/LiquidOrder/Quantum/DreamcyclesInvariant.hs -o dreamcycles

  build-depends:
      base   >= 4.14
    , bytestring
    , containers
    , word8
